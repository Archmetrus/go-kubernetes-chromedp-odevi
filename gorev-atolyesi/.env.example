# Documentation only; scripts do not source this file automatically.
APP_ENV=development
ADDR=127.0.0.1:8091
AUTH_ENABLED=true
ALLOW_SIGNUP=false
APP_VERSION=dev
# PostgreSQL: set DATABASE_URL securely in the process environment.
# DATABASE_URL=postgres://user:password@host:5432/atolye?sslmode=verify-full
# Production additionally requires APP_ORIGIN=https://your-domain and METRICS_TOKEN.
# PostgreSQL is migrated with: go run ./cmd/gorev-atolyesi migrate
# Geliştirmede web kaydı + ilk admin + hesap onayı. AUTH_ENABLED=true gerekir.
# Etkinleştirilmesi DB'de kalıcıdır; henüz staging/production için açılamaz.
ACCOUNT_APPROVAL=false
# Hesap onaylı sunucu ilk açılışta oluşturur; bu dosyayı korumalı yedekleyin.
MFA_KEY_FILE=.control/mfa.key
